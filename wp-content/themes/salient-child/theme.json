{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "custom": true,
      "defaultPalette": false,
      "defaultGradients": false,
      "customDuotone": false,
      "customGradient": false,
      "palette": [
        {
          "slug": "black",
          "color": "#111111",
          "name": "Black"
        },
        {
          "slug": "white",
          "color": "#ffffff",
          "name": "White"
        },
        {
          "slug": "white-soft",
          "color": "#f0f0f0",
          "name": "Soft White"
        },
        {
          "slug": "medium-gray",
          "color": "#676767",
          "name": "Medium Gray"
        },
        {
          "slug": "primary",
          "color": "#1b5c7d",
          "name": "Primary"
        },
        {
          "slug": "secondary",
          "color": "#e5ad42",
          "name": "Secondary"
        },
        {
          "slug": "tertiary",
          "color": "#79a07e",
          "name": "Tertiary"
        },
        {
          "slug": "quaternary",
          "color": "#98b7da",
          "name": "Quaternary"
        },
        {
          "slug": "quinary",
          "color": "#ccb962",
          "name": "Quinary"
        }
      ],
      "gradients": [],
      "link": false
    },
    "custom": {
      "border-radius": {
        "tiny": "3px",
        "small": "8px",
        "medium": "12px",
        "large": "50%"
      },
      "border-width": {
        "tiny": "1px",
        "small": "2px",
        "medium": "3px",
        "large": "4px"
      },
      "box-shadow": {
        "1": "0px 2px 8px rgba(33, 33, 33, 0.12)",
        "2": "0px 3px 10px rgba(33, 33, 33, 0.25)"
      },
      "color": {
        "link" : "#059aba",
        "link-darker" : "#02738b",
        "button-bg" : "#c15646",
        "neutral-50": "#FAFAFA",
        "neutral-100": "#F5F5F5",
        "neutral-200": "#EEEEEE",
        "neutral-300": "#E0E0E0",
        "neutral-400": "#BDBDBD",
        "neutral-500": "#9E9E9E",
        "neutral-600": "#757575",
        "neutral-700": "#616161",
        "neutral-800": "#424242",
        "neutral-900": "#212121"
      },
      "layout": {
        "padding": "16px",
        "padding-small": "8px",
        "padding-large": "64px",
        "block-gap": "24px",
        "block-gap-medium": "32px",
        "block-gap-large": "54px"
      },
      "letter-spacing": {
        "none": "normal",
        "tight": "-.01em",
        "loose": ".05em",
        "looser": ".1em"
      },
      "line-height": {
        "tiny": 1.1,
        "small": 1.2,
        "medium": 1.4,
        "normal": 1.6
      }
    },
    "spacing": {
      "blockGap": true,
      "margin": true,
      "padding": true,
      "units": [
        "%",
        "px",
        "em",
        "rem",
        "vh",
        "vw"
      ]
    },
    "typography": {
      "dropCap": false,
      "lineHeight": true,
      "customFontSize": true,
      "letterSpacing": true,
      "fontStyle": true,
      "fontWeight": true,
      "fontSizes": [
        {
          "name": "Gargantuan",
          "size": "clamp(2.75rem, 5.2vw, 3.25rem)",
          "slug": "gargantuan"
        },
        {
          "name": "Colossal",
          "size": "clamp(2.5rem, 4.8vw, 3rem)",
          "slug": "colossal"
        },
        {
          "name": "Gigantic",
          "size": "clamp(2.125rem, 4.4vw, 2.75rem)",
          "slug": "gigantic"
        },
        {
          "name": "Jumbo",
          "size": "clamp(2rem, 4vw, 2.5rem)",
          "slug": "jumbo"
        },
        {
          "name": "Huge",
          "size": "clamp(1.875rem, 3.6vw, 2.25rem)",
          "slug": "huge"
        },
        {
          "name": "Bigger",
          "size": "clamp(1.75rem, 3.2vw, 2rem)",
          "slug": "bigger"
        },
        {
          "name": "Big",
          "size": "clamp(1.625rem, 3vw, 1.75rem)",
          "slug": "big"
        },
        {
          "name": "Extra Large",
          "size": "clamp(1.5rem, 2.8vw, 1.5rem)",
          "slug": "x-large"
        },
        {
          "name": "Large",
          "size": "1.25rem",
          "slug": "large"
        },
        {
          "name": "Medium",
          "size": "1.125rem",
          "slug": "medium"
        },
        {
          "name": "Small",
          "size": "1rem",
          "slug": "small"
        },
        {
          "name": "Tiny",
          "size": "0.875rem",
          "slug": "tiny"
        },
        {
          "name": "Min",
          "size": "0.75rem",
          "slug": "min"
        }
      ]
    },
    "layout": {
      "contentSize": "1400px",
      "wideSize": "1600px"
    },
    "border": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    }
  },
  "styles": {
    "elements": {
      "link": {
        "color": {
          "text": "var(--wp--custom--color--link)"
        }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--primary)",
          "text": "var(--wp--preset--color--white)"
        },
        "border": {
          "color": "var(--wp--preset--color--black)",
          "width": "1px",
          "radius": "0px"
        },
        "spacing": {
          "padding": "12px 30px"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontSize": "var(--wp--preset--font-size--medium)",
          "fontWeight": "600",
          "lineHeight": "var(--wp--custom--line-height--medium)"
        }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--primary)",
          "fontWeight": "700",
          "lineHeight": "var(--wp--custom--line-height--tiny)"
        }
      },
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--colossal)",
          "lineHeight": "var(--wp--custom--line-height--small)"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--huge)"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--bigger)"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--big)"
        }
      },
      "h5": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--x-large)"
        }
      },
      "h6": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--large)"
        }
      }
    },
    "spacing": {
      "blockGap": "var(--wp--custom--layout--block-gap)"
    },
    "blocks": {
      "core/columns": {
        "spacing": {
          "blockGap": "2rem 4rem"
        }
      }
    }
  }
}